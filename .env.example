# ==============================================================================
# RepoTale Environment Configuration Example
# Copy this file to `.env` and fill in values if needed.
# Note: In the RepoTale UI, API keys can also be configured securely at runtime
# and are saved to your operating system's native keychain (macOS Keychain, etc.).
# ==============================================================================

# Local LLM Inference (Ollama)
# Default: http://localhost:11434
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Optional: Cloud BYOK (Bring Your Own Key) Providers
# VITE_GEMINI_API_KEY=AIzaSy...
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_OPENAI_API_KEY=sk-...
